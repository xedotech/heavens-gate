{
  "name": "heavens-gate",
  "version": "0.1.0",
  "private": true,
  "description": "An original open-source celestial-noir action game for desktop browsers and gamepads.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint app vite.config.ts vitest.config.ts next.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "validate:characters": "node tools/characters/validate_characters.mjs",
    "import:environment": "node tools/environment/import_pavement.mjs && node tools/environment/import_surfaces.mjs",
    "validate:environment": "node tools/environment/validate_environment.mjs",
    "validate:release": "node tools/release/check_release.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.1",
    "@cloudflare/workers-types": "5.20260828.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "react-server-dom-webpack": "19.2.8",
    "sharp": "0.35.2",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "4.127.0"
  },
  "type": "module"
}
